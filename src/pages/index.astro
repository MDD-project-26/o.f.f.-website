---
import Intro from "../components/Intro.astro";
import offWordmark from "../assets/off-wordmark.svg";
import logoMark from "../assets/logo-mark.svg";
import logoFreedom from "../assets/logo-freedom.svg";
import logoFor from "../assets/logo-for.svg";
import logoOptimizing from "../assets/logo-optimizing.svg";
import logoMarkLight from "../assets/logo-mark-light.svg";
import logoFreedomLight from "../assets/logo-freedom-light.svg";
import logoForLight from "../assets/logo-for-light.svg";
import logoOptimizingLight from "../assets/logo-optimizing-light.svg";
import footerOptimizing from "../assets/footer-optimizing.svg?raw";
import footerFor from "../assets/footer-for.svg?raw";
import footerFreedom from "../assets/footer-freedom.svg?raw";
import pagerMetal from "../assets/pager-metal.png";
import benefitRender from "../assets/benefit-render.png";
import offRender01 from "../assets/off-render-01.png";
import offRender02 from "../assets/off-render-02.png";
import offRender03 from "../assets/off-render-03.png";
import offRender04 from "../assets/off-render-04.png";
import problem01 from "../assets/problem-01.png";
import problem02 from "../assets/problem-02.png";
import problem03 from "../assets/problem-03.png";
import problem04 from "../assets/problem-04.png";
import { Image } from "astro:assets";
// Generated by drawings/render-site.cjs from drawings/xteink-x4; hover frames are rendered in the browser
import deviceTeardown from "../assets/xteink-x4-assembled.svg?raw";

const navLinks = [
  { label: "Problem", href: "#problem" },
  { label: "Product", href: "#product" },
  { label: "Demo", href: "#demo" },
  { label: "Vision", href: "#vision" },
];

// Dark module gallery
const darkSlides = [
  {
    image: problem01,
    title: "You picked it up for\none message.",
    copy: "You want to put your phone away, but someone might need you. So you check it. While you’re there, you open something else.",
  },
  {
    image: problem02,
    title: "You’re already hooked.",
    copy: "The messages you need arrive on the same device you’re trying to spend less time using.",
  },
  {
    image: problem03,
    title: "You tried all of the alternatives.",
    copy: "App blockers set limits you can override. Silencing your phone means you might miss something important. Switching to a dumb phone means giving up useful apps, too.",
  },
  {
    image: problem04,
    title: "You’re looking for\na solution that works…",
    copy: "You still need a way to stay reachable while your phone is put away.",
  },
];

// Footer handwriting, inlined so the script can reveal each piece in turn. Figma's ids repeat across the three
// files and its inline style is replaced by the page's CSS, so both go.
const handwriting = (svg: string, word: string) =>
  svg
    .replace(/ id="[^"]*"/g, "")
    .replace(/ style="[^"]*"/, "")
    .replace("<svg ", `<svg class="footer-word footer-word-${word}" aria-hidden="true" focusable="false" `);
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/png" href="/favicon.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <title>o.f.f.</title>
    <!-- Lets CSS hide what scripts will reveal, before first paint and only when scripts run -->
    <script is:inline>
      document.documentElement.classList.add("js");
    </script>
    <meta
      name="description"
      content="A personal device that filters incoming messages and alerts, so the things that matter can reach you while your phone stays out of reach."
    />
    <link rel="preload" href="/fonts/volksans_Regular.otf" as="font" type="font/otf" crossorigin />
    <!-- Tabs and buttons in the first view -->
    <link rel="preload" href="/fonts/ABCArealMono-Medium.woff2" as="font" type="font/woff2" crossorigin />
  </head>
  <body>
    <Intro />

    <header class="site-header">
      <a class="brand" href="/" aria-label="o.f.f. — optimizing for freedom">
        <!-- Each logo part in ink and in light, stacked; the light set shows over the dark module -->
        <span class="brand-mark">
          <img class="on-light" src={logoMark.src} width={logoMark.width} height={logoMark.height} alt="" />
          <img class="on-dark" src={logoMarkLight.src} width={logoMarkLight.width} height={logoMarkLight.height} alt="" />
        </span>
        <span class="brand-wordmark">
          <img class="wm-optimizing on-light" src={logoOptimizing.src} width={logoOptimizing.width} height={logoOptimizing.height} alt="" />
          <img class="wm-for on-light" src={logoFor.src} width={logoFor.width} height={logoFor.height} alt="" />
          <img class="wm-freedom on-light" src={logoFreedom.src} width={logoFreedom.width} height={logoFreedom.height} alt="" />
          <img class="wm-optimizing on-dark" src={logoOptimizingLight.src} width={logoOptimizingLight.width} height={logoOptimizingLight.height} alt="" />
          <img class="wm-for on-dark" src={logoForLight.src} width={logoForLight.width} height={logoForLight.height} alt="" />
          <img class="wm-freedom on-dark" src={logoFreedomLight.src} width={logoFreedomLight.width} height={logoFreedomLight.height} alt="" />
        </span>
      </a>

      <nav class="site-nav" aria-label="Main">
        <ul class="nav-links">
          <li class="nav-indicator" aria-hidden="true"></li>
          {
            navLinks.map((link) => (
              <li>
                <a href={link.href}>
                  {link.label}
                  <!-- Dark copy, clipped by the script to the part of the tab under the indicator -->
                  <span class="nav-label-active" aria-hidden="true">{link.label}</span>
                </a>
              </li>
            ))
          }
        </ul>
        <a class="button-solid" href="#contact">Contact</a>
      </nav>
    </header>

    <main>
      <section class="hero">
        <div class="hero-stage">
          <div class="hero-visual" role="img" aria-label="The o.f.f. logo in liquid metal">
            <div class="hero-shader" data-liquid-metal="Hero" data-mask={offWordmark.src} data-scale="0.8" data-background="rgba(0, 0, 0, 0)"></div>
            <!-- Shown only if the shader can't run -->
            <img class="hero-fallback" src={offWordmark.src} alt="" hidden data-liquid-metal-fallback />
          </div>
        </div>

        <div class="hero-intro">
          <h1>
            <span class="hero-title-line">Put your phone away.</span>
            <span class="hero-title-line hero-title-reveal"><span class="hero-title-word">Stay</span> <span class="hero-title-word">reachable.</span></span>
          </h1>
          <div class="hero-actions">
            <a class="button-solid" href="#contact">Contact</a>
            <a class="button-light" href="#vision">Our vision</a>
          </div>
        </div>
      </section>

      <!-- Dark module: a black pill the size of the viewport scrolls in, then grows with the scroll until it covers it.
           While it's pinned, a clipped-sections gallery plays: each slide is a viewport-tall section scrolling up past
           the screen, with a hairline at each boundary, but its frame and captions stay locked in place and are
           only cut off along the section's edges. -->
      <section class="dark-module" id="problem" style={`--slides: ${darkSlides.length}`}>
        <div class="dark-stage">
          <div class="dark-pill" aria-hidden="true"></div>
          <ol class="dark-gallery">
            {
              darkSlides.map((slide, index) => (
                <li class="dark-slide">
                  <div class="dark-slide-text dark-slide-text-left">
                    <h3 class="dark-slide-line dark-slide-title">
                      <span>{slide.title}</span>
                    </h3>
                  </div>
                  <div class="dark-slide-media" aria-hidden="true">
                    <div class="dark-slide-fill">
                      <Image class="dark-slide-image" src={slide.image} alt="" widths={[490, 980]} sizes="min(61vh, 645px)" />
                    </div>
                  </div>
                  <div class="dark-slide-text dark-slide-text-right">
                    <p class="dark-slide-line">
                      <span>{slide.copy}</span>
                    </p>
                  </div>
                </li>
              ))
            }
          </ol>
          <!-- A hairline at the top of each section; the first carries the section's label below it, like 03 Product's -->
          <div class="dark-rules" aria-hidden="true">
            {
              Array.from({ length: darkSlides.length }, (_, index) => (
                <div class="dark-rule">
                  {index === 0 && (
                    <p class="section-label dark-rule-label">
                      <span>01</span>
                      <span>Problem</span>
                    </p>
                  )}
                </div>
              ))
            }
          </div>
        </div>
      </section>

      <section class="product" id="product" aria-labelledby="product-title">
        <div class="section-rule">
          <span class="section-rule-line" aria-hidden="true"></span>
          <p class="section-label section-label-muted"><span>03</span><span>Product</span></p>
        </div>

        <div class="product-body">
          <h2 class="product-title" id="product-title">Important messages<br />get their own device.</h2>

          <div class="device">
            <figure>
              <Fragment set:html={deviceTeardown} />
              <figcaption>Concept illustration</figcaption>
            </figure>
          </div>

          <div class="product-copy">
            <p>We’re building a small pager that shows selected notifications from your phone.</p>
            <p>
              You set your priorities. <span class="text-muted">AI checks incoming notifications against them and sends
              selected ones to the pager.</span>
            </p>
            <a class="button-solid button-text" href="#demo">See demo</a>
          </div>
        </div>
      </section>

      <section class="benefits" aria-labelledby="benefits-title">
        <h2 class="statement benefits-title" id="benefits-title">
          <span class="text-muted">Why a pager?</span> Read a message without opening your phone.
        </h2>

        <div class="benefit-grid">
          <div class="benefit-row">
            <article class="benefit benefit-video-card benefit-wide">
              <video
                class="benefit-video"
                src="/videos/sunset-sea.mp4"
                poster="/videos/sunset-sea-poster.jpg"
                autoplay
                muted
                loop
                playsinline
                preload="metadata"
                aria-hidden="true"
              ></video>
              <p class="benefit-text" style="--text-width: 533px">
                You can read what came through without picking up your phone. Everything else can wait until you choose to
                check it.
              </p>
            </article>
            <article class="benefit benefit-dark benefit-square">
              <Image class="benefit-fill" src={benefitRender} alt="" widths={[612]} sizes="(max-width: 900px) 90vw, 612px" />
              <p class="benefit-meta"><span>03</span><span>Benefit</span></p>
              <p class="benefit-text" style="--text-width: 338px">
                <span class="text-muted-light">Checking a notification on your phone</span> puts every other app within reach.
              </p>
            </article>
          </div>

          <div class="benefit-row">
            <article class="benefit benefit-dark benefit-square">
              <p class="benefit-meta"><span>03</span><span>Benefit</span></p>
              <Image
                class="benefit-photo"
                src={pagerMetal}
                alt="The o.f.f. logo on the pager’s brushed metal case"
                widths={[551, 1102]}
                sizes="(max-width: 900px) 90vw, 551px"
              />
              <p class="benefit-text" style="--text-width: 480px">
                A dedicated pager gives important messages a separate place to go, <span class="text-muted-light">so
                staying available doesn’t mean keeping your phone in your hand.</span>
              </p>
            </article>
            <article class="benefit benefit-video-card benefit-wide">
              <video
                class="benefit-video"
                src="/videos/skin-close-up.mp4"
                poster="/videos/skin-close-up-poster.jpg"
                autoplay
                muted
                loop
                playsinline
                preload="metadata"
                aria-hidden="true"
              ></video>
              <p class="benefit-text" style="--text-width: 480px">
                You can read what came through without picking up your phone. Everything else can wait until you choose to
                check it.
              </p>
            </article>
          </div>
        </div>
      </section>

      <section class="demo" id="demo" aria-labelledby="demo-title">
        <div class="section-rule">
          <span class="section-rule-line" aria-hidden="true"></span>
          <p class="section-label section-label-muted"><span>03</span><span>Demo</span></p>
        </div>

        <div class="demo-stage" data-orbit>
          <!-- Ten tiles cycling through the four pager renders -->
          <div class="demo-orbit" aria-hidden="true">
            {
              Array.from({ length: 10 }, (_, i) => (
                <div class="demo-tile" data-orbit-tile>
                  <Image
                    src={[offRender03, offRender01, offRender04, offRender02][i % 4]}
                    alt=""
                    widths={[124, 248]}
                    sizes="(max-width: 1476px) 8.4vw, 124px"
                    loading="lazy"
                  />
                </div>
              ))
            }
          </div>

          <div class="demo-intro">
            <h2 class="demo-title" id="demo-title">From your phone to the pager.</h2>
            <p class="demo-lede">See how priorities guide the filter<br />and which notifications reach _off.</p>
            <a class="button-solid button-text" href="/demo">See the demo</a>
          </div>
        </div>

        <script>
          import { mountOrbit } from "../scripts/orbit";

          const reduceMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
          document.querySelectorAll<HTMLElement>("[data-orbit]").forEach((stage) => mountOrbit(stage, reduceMotion));
        </script>
      </section>

      <section class="vision" id="vision" aria-labelledby="vision-title">
        <div class="section-rule">
          <span class="section-rule-line" aria-hidden="true"></span>
          <p class="section-label section-label-muted"><span>04</span><span>Vision</span></p>
        </div>

        <h2 class="statement vision-title" id="vision-title">
          The pager is our first product. Over time, we want to help people decide when information reaches them across
          their devices.
        </h2>

        <div class="vision-body">
          <!-- Image placeholder from the design -->
          <div class="vision-media" aria-hidden="true"></div>
          <div class="vision-copy">
            <p>Our first task is to make leaving your phone alone feel practical, even when someone might need you.</p>
            <p>
              Our next steps are to build a working pager, make the filtering reliable, and run a pilot to find out
              whether people can comfortably leave their phones alone.
            </p>
          </div>
        </div>
      </section>
    </main>

    <footer class="site-footer" id="contact" aria-labelledby="footer-title">
      <div class="footer-cta">
        <!-- The intro's mark (src/components/Intro.astro), drawn in its final "on" state; the script below plays the
             intro's switch-on when the footer comes into view -->
        <svg class="footer-mark" viewBox="0 0 31 20" width="31" height="20" fill="none" aria-hidden="true">
          <defs>
            <mask id="footer-letters-mask" maskUnits="userSpaceOnUse" x="-5" y="-5" width="41" height="30">
              <rect x="-5" y="-5" width="41" height="30" fill="#fff"></rect>
              <rect class="footer-mask-passed" x="-5" y="4.9155" width="15.0004" height="10.1694" fill="#000"></rect>
            </mask>
            <clipPath id="footer-opening-clip">
              <path
                class="footer-opening"
                d="M10 1.53809C5.32682 1.53809 1.53809 5.32682 1.53809 10C1.53809 14.6732 5.32682 18.4619 10 18.4619H20.3848C25.0579 18.4618 28.8457 14.6731 28.8457 10C28.8457 5.32687 25.0579 1.53817 20.3848 1.53809H10Z"
              ></path>
            </clipPath>
          </defs>
          <path
            class="footer-ring"
            d="M20.3848 0C25.9075 8.09981e-05 30.3848 4.4772 30.3848 10C30.3848 15.4797 25.977 19.9298 20.5137 19.999L20.3848 20H10L9.87109 19.999C4.40779 19.9298 0 15.4797 0 10C9.66387e-08 4.47715 4.47715 2.01953e-07 10 0H20.3848ZM10 1.53809C5.32682 1.53809 1.53809 5.32682 1.53809 10C1.53809 14.6732 5.32682 18.4619 10 18.4619H20.3848C25.0579 18.4618 28.8457 14.6731 28.8457 10C28.8457 5.32687 25.0579 1.53817 20.3848 1.53809H10Z"
            fill-rule="evenodd"
            clip-rule="evenodd"></path>
          <g clip-path="url(#footer-opening-clip)">
            <g mask="url(#footer-letters-mask)">
              <g class="footer-letters">
                <path d="M19.6155 4.6154C20.0404 4.6154 20.3848 4.9598 20.3848 5.38463C20.3848 5.80947 20.0404 6.15386 19.6155 6.15386C18.7659 6.15386 18.0771 6.84266 18.0771 7.69233L18.0771 14.6154C18.0771 15.0402 17.7327 15.3846 17.3078 15.3846C16.883 15.3846 16.5386 15.0402 16.5386 14.6154L16.5386 7.69232C16.5386 5.99299 17.9162 4.6154 19.6155 4.6154Z"></path>
                <path d="M23.4617 4.6154C23.8866 4.6154 24.231 4.9598 24.231 5.38463C24.231 5.80947 23.8866 6.15386 23.4617 6.15386C22.6121 6.15386 21.9233 6.84266 21.9233 7.69233L21.9233 14.6154C21.9233 15.0402 21.5789 15.3846 21.154 15.3846C20.7292 15.3846 20.3848 15.0402 20.3848 14.6154L20.3848 7.69232C20.3848 5.99299 21.7624 4.6154 23.4617 4.6154Z"></path>
                <path d="M13.8462 10.1925C13.8462 9.76768 14.1906 9.42328 14.6154 9.42328H23.4616C23.8864 9.42328 24.2308 9.76768 24.2308 10.1925V10.1925C24.2308 10.6173 23.8864 10.9617 23.4616 10.9617H14.6154C14.1906 10.9617 13.8462 10.6173 13.8462 10.1925V10.1925Z"></path>
              </g>
            </g>
            <g class="footer-knob">
              <circle class="footer-knob-core" cx="10.0004" cy="10.0002" r="4.2"></circle>
              <path d="M10.0004 4.6154C12.9741 4.61548 15.3851 7.02638 15.3851 10.0002C15.3851 12.9739 12.9741 15.3849 10.0004 15.3849C7.02658 15.3849 4.61568 12.9739 4.6156 10.0002C4.6156 7.02633 7.02653 4.6154 10.0004 4.6154ZM10.0004 6.15349C7.87619 6.15349 6.15369 7.876 6.15369 10.0002C6.15377 12.1243 7.87624 13.8459 10.0004 13.8459C12.1244 13.8458 13.846 12.1242 13.8461 10.0002C13.8461 7.87605 12.1245 6.15357 10.0004 6.15349Z"></path>
            </g>
          </g>
        </svg>
        <h2 class="footer-title" id="footer-title">Help us bring Off<br />into everyday use.</h2>
        <div class="footer-actions">
          <a class="button-solid button-text footer-button-primary" href="#contact">Contact</a>
          <a class="button-solid button-text footer-button-ghost" href="#demo">See demo</a>
        </div>
      </div>

      <!-- Handwritten "optimizing for freedom": three SVGs placed as in the 1480 × 248 Figma frame, written out
           piece by piece when the footer scrolls into view -->
      <div class="footer-handwriting" role="img" aria-label="optimizing for freedom">
        <Fragment set:html={handwriting(footerOptimizing, "optimizing")} />
        <Fragment set:html={handwriting(footerFor, "for")} />
        <Fragment set:html={handwriting(footerFreedom, "freedom")} />
      </div>

      <div class="footer-bar">
        <p class="footer-copyright">© 2026 Off</p>
        <p class="footer-tagline">Optimizing For Freedom</p>
        <p class="footer-credit">Designed &amp; Developed by <span class="footer-credit-name">LORE</span></p>
      </div>
    </footer>

    <script>
      import { animate } from "motion";

      const reduceMotion = window.matchMedia("(prefers-reduced-motion: reduce)");

      // Tabs follow the scroll position. Each section's tab takes over when the section's top reaches the middle
      // of the viewport, and the indicator travels there over the last 40% of a viewport of scrolling before that,
      // scrubbed by the scroll itself (smoothstep within that stretch): it stops when scrolling stops and reverses
      // with it. Above the first section (the hero) it hasn't filled in at all, and it fills in from the left. The active tab switches halfway through each stretch. With reduced motion the indicator
      // snaps at the switch instead of travelling.
      const list = document.querySelector<HTMLUListElement>(".nav-links");
      const indicator = list?.querySelector<HTMLElement>(".nav-indicator");

      if (list && indicator) {
        const tabs = [...list.querySelectorAll<HTMLAnchorElement>("a")].map((link) => ({
          link,
          label: link.querySelector<HTMLElement>(".nav-label-active")!,
          section: link.hash ? document.getElementById(link.hash.slice(1)) : null,
        }));
        const TRAVEL = 0.4; // share of the viewport height scrolled while the indicator travels
        let current: HTMLAnchorElement | null = null;

        // reveal: how far the indicator has filled in from its left edge (0 to 1)
        type Pose = { x: number; width: number; reveal: number };
        // Exact (fractional) box of a tab, measured from the bar's outer left edge
        const box = (link: HTMLAnchorElement) => {
          const bar = list.getBoundingClientRect();
          const rect = link.getBoundingClientRect();
          return { x: rect.left - bar.left, width: rect.width };
        };
        // No tab: the indicator sits on the first tab, not filled in at all. It fills in as a round shape the whole
        // way: while it's narrower than it is tall, a disc slides in from the left, clipped by its own rounded left
        // end (concentric with the bar's); once the disc is whole it stretches into the full pill. Its leading edge
        // moves at a steady rate through both. A plain shrinking width would squash its corners instead.
        const pose = (link: HTMLAnchorElement | null): Pose =>
          link ? { ...box(link), reveal: 1 } : { ...box(tabs[0].link), reveal: 0 };
        // Moves the indicator and clips each tab's dark label to the part of the tab it covers, so the text turns
        // dark exactly under the white and stays grey beside it.
        // The indicator always keeps the bar's 1px grey edge (its padding) clear on every side.
        const place = (target: Pose) => {
          const boxes = tabs.map(({ link }) => box(link));
          const inner = { left: 1, right: list.getBoundingClientRect().width - 1 };
          const left = Math.min(Math.max(target.x, inner.left), inner.right);
          const right = Math.min(Math.max(target.x + target.width, left), inner.right);
          // The white's leading edge, measured from the indicator's left
          const edge = (right - left) * target.reveal;
          const shown = left + edge;
          const height = indicator.offsetHeight;
          // The bar has no border, so the indicator's left: 0 is the bar's outer edge, the same origin as the boxes
          indicator.style.transform = `translateX(${left}px)`;
          if (edge < height) {
            // Disc phase: a circle as tall as the indicator, its right side at the leading edge
            indicator.style.width = `${height}px`;
            indicator.style.clipPath = `circle(${height / 2}px at ${edge - height / 2}px 50%)`;
          } else {
            indicator.style.width = `${edge}px`;
            indicator.style.clipPath = "";
          }
          tabs.forEach(({ label }, index) => {
            const tab = boxes[index];
            const clamp = (n: number) => Math.min(Math.max(n, 0), tab.width);
            label.style.clipPath = `inset(0 ${clamp(tab.x + tab.width - shown)}px 0 ${clamp(left - tab.x)}px)`;
          });
        };
        const smoothstep = (t: number) => t * t * (3 - 2 * t);

        const setCurrent = (link: HTMLAnchorElement | null) => {
          if (link === current) return;
          tabs.forEach((tab) => tab.link.removeAttribute("aria-current"));
          link?.setAttribute("aria-current", "page");
          current = link;
        };

        const update = () => {
          const middle = window.innerHeight / 2;
          const travel = window.innerHeight * TRAVEL;
          // Each section with a tab, in page order, with how far its top still is from the viewport's middle
          const stops = tabs.flatMap(({ link, section }) =>
            section ? [{ link, distance: section.getBoundingClientRect().top - middle }] : [],
          );
          let from: HTMLAnchorElement | null = null;
          for (const { link, distance } of stops) {
            if (distance > travel) break;
            if (distance > 0) {
              // Travelling towards this tab
              const progress = reduceMotion.matches ? 0 : smoothstep(1 - distance / travel);
              const a = pose(from);
              const b = pose(link);
              const mix = (key: keyof Pose) => a[key] + (b[key] - a[key]) * progress;
              place({ x: mix("x"), width: mix("width"), reveal: mix("reveal") });
              setCurrent(progress >= 0.5 ? link : from);
              return;
            }
            from = link;
          }
          place(pose(from));
          setCurrent(from);
        };

        update();
        list.classList.add("is-enhanced");

        let queued = false;
        const queue = () => {
          if (queued) return;
          queued = true;
          requestAnimationFrame(() => {
            queued = false;
            update();
          });
        };
        window.addEventListener("scroll", queue, { passive: true });
        // Font loading and breakpoint changes alter tab widths and section positions
        new ResizeObserver(queue).observe(list);
        window.addEventListener("resize", queue);
      }

      // Every in-page link (nav tabs and CTAs alike) scrolls smoothly to its section, and the nav's indicator
      // follows the scroll. Links whose section doesn't exist yet do nothing.
      // Other browsers' smooth scroll feels right, but Safari's covers any distance in the same short time, so
      // there it's tweened with Motion instead: longer the farther it goes, and stopped as soon as the visitor scrolls.
      const isSafari = /^((?!chrome|chromium|crios|fxios|android).)*safari/i.test(navigator.userAgent);
      const RULE_GAP = 12; // px between the header's bottom and a section's rule once scrolled to it
      let scrolling: ReturnType<typeof animate> | undefined;
      const stopScrolling = () => scrolling?.stop();
      ["wheel", "touchstart", "keydown"].forEach((type) => window.addEventListener(type, stopScrolling, { passive: true }));
      document.querySelectorAll<HTMLAnchorElement>('a[href^="#"]').forEach((link) =>
        link.addEventListener("click", (event) => {
          event.preventDefault();
          const section = link.hash
            ? (document.getElementById(link.hash.slice(1)) as (HTMLElement & { scrollYForRule?: (ruleTop: number) => number }) | null)
            : null;
          if (!section) return;
          stopScrolling();
          const maxY = document.documentElement.scrollHeight - innerHeight;
          // Sections with a rule above their label (01 Problem, 03 Product…) land with the rule RULE_GAP below the
          // header; the pinned gallery's rule moves with the scroll, so that section works out its own position
          const rule = section.querySelector<HTMLElement>(".section-rule");
          const header = document.querySelector<HTMLElement>(".site-header");
          const ruleTop = (header?.getBoundingClientRect().bottom ?? 0) + RULE_GAP;
          const target = section.scrollYForRule
            ? section.scrollYForRule(ruleTop)
            : rule
              ? rule.getBoundingClientRect().top + scrollY - ruleTop
              : section.getBoundingClientRect().top + scrollY;
          const to = Math.min(Math.max(target, 0), maxY);
          if (reduceMotion.matches) return window.scrollTo(0, to);
          if (!isSafari) return window.scrollTo({ top: to, behavior: "smooth" });
          const distance = Math.abs(to - scrollY);
          scrolling = animate(scrollY, to, {
            duration: Math.min(0.6 + distance / 5000, 1.6),
            ease: [0.65, 0, 0.35, 1],
            onUpdate: (y) => window.scrollTo(0, y),
          });
        }),
      );
    </script>

    <script>
      import { animate } from "motion";

      // Footer handwriting. The words are filled outlines, not strokes, so each piece (a letter or a run of joined
      // letters) is uncovered left to right by a mask with a soft leading edge, like ink following the pen. Pieces
      // go in reading order at one pen speed, each starting just before the last one ends, with a short pause
      // between words. It starts once, when the words are well into view; with reduced motion they just show.
      const handwriting = document.querySelector<HTMLElement>(".footer-handwriting");
      const reduceMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

      if (handwriting && !reduceMotion) {
        const SVG_NS = "http://www.w3.org/2000/svg";
        const SPEED = 50000; // pen speed, in SVG units per second (the three files share one scale)
        const FEATHER = 28; // width of the soft leading edge, in SVG units
        const PAD = 4; // margin around each piece so antialiased edges aren't clipped
        const OVERLAP = 0.15; // share of a piece left to go when the next one starts
        const WORD_PAUSE = 0.06; // seconds between words

        type Stroke = { band: SVGGElement; path: SVGPathElement; distance: number };
        const words: Stroke[][] = [];
        let maskId = 0;

        handwriting.querySelectorAll<SVGSVGElement>("svg").forEach((svg) => {
          const defs = svg.insertBefore(document.createElementNS(SVG_NS, "defs"), svg.firstChild);
          const strokes = [...svg.querySelectorAll<SVGPathElement>("path")]
            .map((path) => ({ path, box: path.getBBox() }))
            .sort((a, b) => a.box.x - b.box.x)
            .map(({ path, box }) => {
              const id = `handwriting-${maskId++}`;
              const width = box.width + 2 * PAD + FEATHER; // solid part, wide enough to cover the piece at the end
              const top = box.y - PAD;
              const height = box.height + 2 * PAD;
              const mask = document.createElementNS(SVG_NS, "mask");
              mask.id = id;
              mask.setAttribute("maskUnits", "userSpaceOnUse");
              mask.innerHTML = `
                <linearGradient id="${id}-edge"><stop offset="0" stop-color="#fff" /><stop offset="1" stop-color="#fff" stop-opacity="0" /></linearGradient>
                <g transform="translate(${-FEATHER} 0)">
                  <rect x="${box.x - width}" y="${top}" width="${width}" height="${height}" fill="#fff" />
                  <rect x="${box.x}" y="${top}" width="${FEATHER}" height="${height}" fill="url(#${id}-edge)" />
                </g>`;
              defs.append(mask);
              path.setAttribute("mask", `url(#${id})`);
              return { band: mask.querySelector("g")!, path, distance: box.width + 2 * PAD + FEATHER };
            });
          words.push(strokes);
        });

        const write = () => {
          let at = 0;
          words.forEach((strokes, index) => {
            if (index > 0) at += WORD_PAUSE;
            strokes.forEach(({ band, path, distance }, i) => {
              const duration = Math.max(distance / SPEED, 0.06);
              animate(-FEATHER, distance - FEATHER, {
                delay: at,
                duration,
                ease: [0.4, 0, 0.6, 1],
                onUpdate: (x) => band.setAttribute("transform", `translate(${x} 0)`),
                onComplete: () => path.removeAttribute("mask"),
              });
              at += i === strokes.length - 1 ? duration : duration * (1 - OVERLAP);
            });
          });
        };

        const observer = new IntersectionObserver(
          ([entry]) => {
            if (!entry.isIntersecting) return;
            observer.disconnect();
            write();
          },
          { threshold: 0.6 },
        );
        observer.observe(handwriting);
      }
    </script>

    <script>
      import { animate, motionValue } from "motion";

      // Footer mark: the intro's switch (src/components/Intro.astro), same timing and curve. The knob moves from
      // off to on, the ff sliding into place with it. Plays once, when the mark is well into view.
      // Without JS or with reduced motion the mark just shows in its "on" state.
      const mark = document.querySelector<SVGSVGElement>(".footer-mark");
      const reduceMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

      if (mark && !reduceMotion) {
        const knob = mark.querySelector<SVGGElement>(".footer-knob")!;
        const letters = mark.querySelector<SVGGElement>(".footer-letters")!;
        const maskPassed = mark.querySelector<SVGRectElement>(".footer-mask-passed")!;

        const TEMPO = 1.4;
        const SWITCH_DURATION = 0.26;
        const cubicInOut = (t: number) => (t < 0.5 ? 4 * t ** 3 : 1 - (-2 * t + 2) ** 3 / 2);
        const clamp01 = (n: number) => Math.min(Math.max(n, 0), 1);

        const KNOB_TRAVEL = 10.3844;
        const LETTERS_SHIFT = 2;
        const KNOB_RADIUS = 5.3847;
        const MASK_MARGIN = 0.5;
        const MASK_INSET = 0.3;
        const KNOB_CENTRE_Y = 10.0002;

        const knobX = motionValue(KNOB_TRAVEL);
        const renderSwitch = () => {
          const x = knobX.get();
          const progress = clamp01(x / KNOB_TRAVEL);
          knob.setAttribute("transform", `translate(${x} 0)`);
          letters.setAttribute("transform", `translate(${-LETTERS_SHIFT * progress} 0)`);
          const bandRadius = KNOB_RADIUS - MASK_INSET + (MASK_MARGIN + MASK_INSET) * clamp01(progress * 4);
          maskPassed.setAttribute("y", String(KNOB_CENTRE_Y - bandRadius));
          maskPassed.setAttribute("height", String(2 * bandRadius));
          maskPassed.setAttribute("width", String(15.0004 + x));
        };
        knobX.on("change", renderSwitch);

        // Start switched off
        renderSwitch();

        const observer = new IntersectionObserver(
          ([entry]) => {
            if (!entry.isIntersecting) return;
            observer.disconnect();
            const timeline = animate(knobX, [KNOB_TRAVEL, 0], {
              duration: SWITCH_DURATION * TEMPO,
              ease: cubicInOut,
              reduceMotion: false,
            });
            // The knob's solid centre only covers seams while it moves
            timeline.then(() => mark.querySelector(".footer-knob-core")?.remove());
          },
          { threshold: 1, rootMargin: "0px 0px -15% 0px" },
        );
        observer.observe(mark);
      }
    </script>

    <script>
      import { mountLiquidMetal } from "../scripts/liquid-metal";

      const reduceMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
      document.querySelectorAll<HTMLElement>("[data-liquid-metal]").forEach((container) =>
        mountLiquidMetal(container, reduceMotion),
      );
    </script>

    <script>
      import { scroll } from "motion";

      // Dark module: from when it enters the viewport, the pill squares off and grows; on the way out it shrinks back around its centre with the scroll until its rounded
      // ends clear the viewport's corners. The covering scale depends on the viewport's shape, so it's measured.
      const stage = document.querySelector<HTMLElement>(".dark-stage");
      const pill = document.querySelector<HTMLElement>(".dark-pill");
      const header = document.querySelector<HTMLElement>(".site-header");
      const footer = document.querySelector<HTMLElement>(".site-footer");

      // The header goes dark over anything black: the dark module's pill or the footer
      let overPill = false;
      let overFooter = false;
      const updateHeader = () => header?.classList.toggle("is-dark", overPill || overFooter);

      if (header && footer) {
        const checkFooter = () => {
          const headerBox = header.getBoundingClientRect();
          overFooter = footer.getBoundingClientRect().top <= headerBox.top + headerBox.height / 2;
          updateHeader();
        };
        addEventListener("scroll", checkFooter, { passive: true });
        addEventListener("resize", checkFooter);
        checkFooter();
      }

      if (stage && pill) {
        // The design's 2070px pill over a 1512x948 viewport is this much past the smallest covering scale
        const COVER_MARGIN = 1.056;
        const reduceMotion = window.matchMedia("(prefers-reduced-motion: reduce)");

        // Smallest scale at which the stadium (semicircle ends on its short side) contains the box's corners
        const coverScale = () => {
          const a = Math.max(stage.clientWidth, stage.clientHeight) / 2;
          const b = Math.min(stage.clientWidth, stage.clientHeight) / 2;
          const covers = (s: number) => {
            const straight = (a - b) * s; // half-length of the straight part
            return a <= straight || Math.hypot(a - straight, b) <= b * s;
          };
          let low = 1;
          let high = a / b + 1;
          for (let i = 0; i < 24; i++) {
            const mid = (low + high) / 2;
            if (covers(mid)) high = mid;
            else low = mid;
          }
          return high * COVER_MARGIN;
        };

        let cover = coverScale();
        // In: from when the module's top enters the viewport until it reaches the top. Out, the same in reverse:
        // from when its bottom reaches the viewport's bottom until it leaves at the top.
        let progressIn = 0;
        let progressOut = 0;
        const render = () => {
          const p = reduceMotion.matches ? 1 : progressIn * (1 - progressOut);
          const scale = 1 + (cover - 1) * p;

          // The header turns dark while the pill's edge is past its middle, on the way in and out alike. The pill
          // is scaled around the stage's centre, so its edges come from the stage's box without measuring it.
          if (header) {
            const box = stage.getBoundingClientRect();
            const headerBox = header.getBoundingClientRect();
            const middle = headerBox.top + headerBox.height / 2;
            const centre = box.top + box.height / 2;
            const half = (box.height / 2) * scale;
            overPill = centre - half <= middle && middle <= centre + half;
            updateHeader();
          }

          pill.style.transform = `scale(${scale})`;
          // The corners square off on the same progress: from the full stadium (half the short side) to none
          pill.style.borderRadius = `${(Math.min(stage.clientWidth, stage.clientHeight) / 2) * (1 - p)}px`;
        };
        addEventListener("resize", () => {
          cover = coverScale();
          render();
        });
        scroll(
          (value: number) => {
            progressIn = value;
            render();
          },
          { target: stage.parentElement!, offset: ["start end", "start start"] },
        );
        scroll(
          (value: number) => {
            progressOut = value;
            render();
          },
          { target: stage.parentElement!, offset: ["end end", "end start"] },
        );

        // Gallery: while the stage is pinned, the slides scroll past as sections, one after another: the first starts
        // centred and the last ends centred. A section is its frame with SECTION_PAD above and below, and a
        // rule at its top. The fill drifts inside its frame as it crosses the viewport. The captions stay put,
        // masked to their section: as a rule crosses the viewport's middle, the old slide's captions move up and
        // blur out as the new one's move up into place and come into focus, in step with the scroll.
        //
        // Frames are at EDGE_SCALE at the viewport's edges and full size in its middle, with the pad kept exact, so
        // the sections shrink with their frames. That's done by squeezing the stack towards the edges: a section
        // through the middle is full size and moves 1:1 with the scroll; from there to the edges the squeeze ramps up
        // until sections are just tall enough for a frame at EDGE_SCALE. Each frame then fills its section, less the
        // pad. Positions come from one continuous mapping, so nothing jumps as sections change size.
        const slides = [...stage.querySelectorAll<HTMLElement>(".dark-slide")].map((slide) => ({
          slide,
          captions: [...slide.querySelectorAll<HTMLElement>(".dark-slide-text")],
          media: slide.querySelector<HTMLElement>(".dark-slide-media")!,
          fill: slide.querySelector<HTMLElement>(".dark-slide-fill")!,
          shift: 0, // the frame's current translateY
          scale: 1, // and scale
        }));
        const rules = [...stage.querySelectorAll<HTMLElement>(".dark-rule")];
        const SECTION_PAD = 96; // matches the 192px in .dark-module's height
        const ZOOM = 1.3; // the photo's scale inside its frame, matching .dark-slide-fill
        // % of the frame's height the photo drifts each way while its frame crosses the viewport; kept inside the
        // (ZOOM - 1) / 2 the zoom leaves above and below, so the frame never shows an edge
        const PARALLAX = 14;
        const EDGE_SCALE = 0.8;

        // Captions, driven by the scroll: a slide's captions come in as its top rule crosses a band around the
        // viewport's middle and go out as its bottom rule does, so one slide's go out as the next one's come in
        const CAPTION_RISE = 10; // px each caption moves up, out of view or into place
        const CAPTION_BAND = 160; // px of the rule's travel, centred on the middle, that the swap plays over
        const CAPTION_BLUR = 8; // px of blur on a caption that's out

        // The gallery's geometry at the current size: the section height, the squeeze, and where the first
        // section's top starts and ends (unsqueezed) over the pinned scroll
        const geometry = () => {
          const height = stage.clientHeight;
          // Every frame has the same height; where the layout puts a frame (centred) in the stage, before it's moved.
          // Measured unrounded, so the pad stays exact, with the current transform taken out: the scale is around the
          // frame's centre, so the centre is only moved by the shift.
          const stageTop = stage.getBoundingClientRect().top;
          const frameBoxes = slides.map(({ media }) => media.getBoundingClientRect());
          const frameHeight = frameBoxes[0].height / slides[0].scale;
          const frameCentres = slides.map(
            ({ shift }, index) => frameBoxes[index].top + frameBoxes[index].height / 2 - stageTop - shift,
          );
          const section = frameHeight + 2 * SECTION_PAD;

          // The squeeze: unsqueezed positions map to on-screen ones through squeeze(), whose slope is 1 for the
          // middle section's length around the centre, ramps down over `ramp` to `edge` at the viewport's edges, and
          // stays there beyond them. `edge` leaves a squeezed section just room for a frame at EDGE_SCALE.
          const edge = reduceMotion.matches ? 1 : (EDGE_SCALE * frameHeight + 2 * SECTION_PAD) / section;
          const centre = height / 2;
          const flat = section / 2;
          const ramp = Math.max(centre - flat, 1);
          const squeeze = (y: number) => {
            const distance = Math.abs(y - centre);
            const inRamp = Math.min(Math.max(distance - flat, 0), ramp);
            const beyond = Math.max(distance - flat - ramp, 0);
            const squeezed =
              Math.min(distance, flat) + inRamp - ((1 - edge) / (2 * ramp)) * inRamp ** 2 + edge * beyond;
            return centre + Math.sign(y - centre) * squeezed;
          };

          // Unsqueezed top of the first section: from centred in the viewport, so it's already in place as the pill
          // grows in, until the last section is centred, so it stays in place as the pill shrinks out. Section
          // positions are relative to the stage, which is the viewport while it's pinned.
          const start = centre - section / 2;
          const end = start - (slides.length - 1) * section;
          return { height, centre, section, squeeze, start, end, frameHeight, frameCentres };
        };

        // For in-page links: the scroll position at which the first section's rule sits at `ruleTop` in the
        // viewport. The squeeze only ever increases, so it's inverted by bisection to find the gallery's progress.
        const darkModule = stage.parentElement as HTMLElement & { scrollYForRule?: (ruleTop: number) => number };
        if (rules.length) {
          darkModule.scrollYForRule = (ruleTop) => {
            const { squeeze, start, end } = geometry();
            let low = end;
            let high = start;
            for (let i = 0; i < 40; i++) {
              const mid = (low + high) / 2;
              if (squeeze(mid) < ruleTop) low = mid;
              else high = mid;
            }
            const value = Math.min(Math.max((start - (low + high) / 2) / (start - end), 0), 1);
            const top = darkModule.getBoundingClientRect().top + scrollY;
            return top + value * (darkModule.offsetHeight - stage.clientHeight);
          };
        }

        const renderGallery = (value: number) => {
          const { height, centre, section, squeeze, start, end, frameHeight, frameCentres } = geometry();
          const offset = start + value * (end - start);
          // Each section's top and the last one's bottom; only the tops have a rule
          const boundaries = Array.from({ length: slides.length + 1 }, (_, index) => squeeze(offset + index * section));

          // 0 while a rule is below the band, 1 once it's above it
          const passed = (y: number) => Math.min(Math.max((centre + CAPTION_BAND / 2 - y) / CAPTION_BAND, 0), 1);
          const rise = reduceMotion.matches ? 0 : CAPTION_RISE;
          slides.forEach(({ captions }, index) => {
            const shownIn = passed(boundaries[index]);
            const goneOut = passed(boundaries[index + 1]);
            captions.forEach((caption) => {
              // No filter at all once it's in focus: Safari leaves stray coloured pixels at a filtered box's edge
              const blur = CAPTION_BLUR * (1 - shownIn * (1 - goneOut));
              caption.style.filter = blur > 0.01 ? `blur(${blur}px)` : "none";
              caption.style.transform = `translateY(${rise * (1 - shownIn) - rise * goneOut}px)`;
            });
          });

          rules.forEach((rule, index) => {
            const y = boundaries[index];
            rule.style.transform = `translateY(${y}px)`;
            rule.style.visibility = y > 0 && y < height ? "visible" : "hidden";
          });
          slides.forEach((item, index) => {
            const { slide, media, fill } = item;
            const top = boundaries[index];
            const bottom = boundaries[index + 1];
            // Masked to its section, so the rules cut through the captions as they pass
            slide.style.clipPath = `inset(${Math.min(Math.max(top, 0), height)}px 0 ${Math.min(Math.max(height - bottom, 0), height)}px 0)`;
            // The frame fills its section, less the pad
            item.scale = (bottom - top - 2 * SECTION_PAD) / frameHeight;
            item.shift = (top + bottom) / 2 - frameCentres[index];
            media.style.transform = `translateY(${item.shift}px) scale(${item.scale})`;
            // -1 as the frame enters at the bottom, 1 as it leaves at the top
            const frameBottom = bottom - SECTION_PAD;
            const travel = Math.min(Math.max(1 - (2 * frameBottom) / (height + frameHeight), -1), 1);
            if (!reduceMotion.matches) fill.style.transform = `translateY(${-travel * PARALLAX}%) scale(${ZOOM})`;
          });
        };
        scroll(renderGallery, { target: stage.parentElement!, offset: ["start start", "end end"] });
        render();
      }
    </script>

    <script>
      import { inView } from "motion";

      // Section labels decrypt once they're fully in view: they start empty and type out left to right, number
      // first, then the name, one character every STAGGER. Each character arrives as a random glyph, cycles for
      // LEAD, then settles on the real one, so the label grows by one character per step while the ones behind
      // settle. The font is monospaced, so nothing shifts while the glyphs change. Screen readers get the real text from a hidden copy; the scrambling copy is
      // hidden from them.
      const GLYPHS = "ABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789#%&*+=/<>";
      const SWAP = 50; // ms each random glyph shows
      const LEAD = 250; // ms each character scrambles before it settles
      const STAGGER = 45; // ms between characters appearing (and settling)
      const reduceMotion = window.matchMedia("(prefers-reduced-motion: reduce)");
      const randomGlyph = () => GLYPHS[Math.floor(Math.random() * GLYPHS.length)];

      document.querySelectorAll<HTMLElement>(".section-label").forEach((label) => {
        const parts = [...label.querySelectorAll<HTMLElement>(":scope > span")].map((span) => {
          const text = span.textContent ?? "";
          const copy = document.createElement("span");
          copy.textContent = text;
          copy.style.cssText = "position:absolute;width:1px;height:1px;overflow:hidden;clip-path:inset(50%);white-space:nowrap";
          const shown = document.createElement("span");
          shown.setAttribute("aria-hidden", "true");
          shown.textContent = reduceMotion.matches ? text : "";
          span.replaceChildren(copy, shown);
          return { text, shown };
        });
        label.classList.add("is-ready");
        if (reduceMotion.matches) return;

        inView(
          label,
          () => {
            const start = performance.now();
            let lastSwap = -Infinity;
            const frame = (now: number) => {
              const elapsed = now - start;
              const swap = now - lastSwap >= SWAP;
              if (swap) lastSwap = now;
              let index = 0; // across both parts, so the name follows the number
              let done = true;
              parts.forEach(({ text, shown }) => {
                const current = [...(shown.textContent ?? "")];
                const next = [...text].flatMap((char, i) => {
                  const appearsAt = (index + i) * STAGGER;
                  if (elapsed < LEAD + appearsAt) done = false;
                  if (elapsed < appearsAt) return []; // not typed yet
                  if (elapsed >= LEAD + appearsAt || char === " ") return [char];
                  // Just arrived, or due a new glyph
                  return [swap || current[i] === undefined ? randomGlyph() : current[i]];
                });
                index += text.length;
                shown.textContent = next.join("");
              });
              if (!done) requestAnimationFrame(frame);
            };
            requestAnimationFrame(frame);
          },
          { amount: "all" },
        );
      });
    </script>

    <script>
      import { animate, inView, motionValue } from "motion";

      // Explodes the teardown once, when it scrolls into view. Each pose needs its own hidden-line
      // pass, so a worker renders the frames once the page is idle; Motion then plays a progress
      // value through them (linear, since the frames already carry the easing).
      const figure = document.querySelector<HTMLElement>(".device figure");
      const frameGroup = figure?.querySelector<SVGGElement>(".teardown-frame");

      if (figure && frameGroup) {
        const FRAMES = 24;
        const DURATION = 0.6;
        const reduceMotion = window.matchMedia("(prefers-reduced-motion: reduce)");
        const frames: SVGGElement[] = [];
        const progress = motionValue(0);
        let rendered = 0;
        let inViewport = false;
        let shown = 0;

        progress.on("change", (value) => {
          const index = Math.round(value * (FRAMES - 1));
          if (index === shown) return;
          frameGroup.replaceChildren(frames[index]);
          shown = index;
        });

        const play = () => {
          if (!inViewport || rendered < FRAMES) return;
          if (reduceMotion.matches) progress.set(1);
          else animate(progress, 1, { duration: DURATION, ease: "linear" });
        };

        const worker = new Worker(new URL("../scripts/teardown-worker.js", import.meta.url), { type: "module" });
        worker.onmessage = ({ data }: MessageEvent<{ index: number; markup: string }>) => {
          const frame = document.createElementNS("http://www.w3.org/2000/svg", "g");
          frame.innerHTML = data.markup;
          frames[data.index] = frame;
          if (++rendered === FRAMES) {
            worker.terminate();
            play(); // catch up if the figure came into view while frames were rendering
          }
        };
        const start = () => worker.postMessage({ id: "xteink-x4", frames: FRAMES });
        if ("requestIdleCallback" in window) requestIdleCallback(start);
        else setTimeout(start, 1000);

        // Returning nothing makes this fire once, so the device stays exploded afterwards
        inView(
          figure,
