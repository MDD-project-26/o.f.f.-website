---
import offWordmark from "../assets/off-wordmark.svg";
import logoMark from "../assets/logo-mark.svg";
import logoMarkMask from "../assets/logo-mark-mask.svg";
import logoFreedom from "../assets/logo-freedom.svg";
import logoFor from "../assets/logo-for.svg";
import logoOptimizing from "../assets/logo-optimizing.svg";
// Generated by drawings/render-site.cjs from drawings/xteink-x4; hover frames are rendered in the browser
import deviceTeardown from "../assets/xteink-x4-assembled.svg?raw";

const navLinks = [
  { label: "Product", href: "#product", current: true },
  { label: "How it works", href: "#how-it-works" },
  { label: "Our vision", href: "#vision" },
];
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>o.f.f.</title>
    <meta
      name="description"
      content="A personal device that filters incoming messages and alerts, so the things that matter can reach you while your phone stays out of reach."
    />
    <link rel="preload" href="/fonts/volksans_Regular.otf" as="font" type="font/otf" crossorigin />
  </head>
  <body>
    <header class="site-header">
      <a class="brand" href="/" aria-label="o.f.f. — optimizing for freedom">
        <span class="brand-mark">
          <!-- Flat mark stays until the shader is ready, and remains if it can't run -->
          <img src={logoMark.src} width={logoMark.width} height={logoMark.height} alt="" />
          <span
            class="brand-mark-shader"
            data-liquid-metal
            data-mask={logoMarkMask.src}
            data-scale="0.89"
            data-background="rgba(0, 0, 0, 0)"
            data-pixel-ratio="3"></span>
        </span>
        <span class="brand-wordmark">
          <img class="wm-optimizing" src={logoOptimizing.src} width={logoOptimizing.width} height={logoOptimizing.height} alt="" />
          <img class="wm-for" src={logoFor.src} width={logoFor.width} height={logoFor.height} alt="" />
          <img class="wm-freedom" src={logoFreedom.src} width={logoFreedom.width} height={logoFreedom.height} alt="" />
        </span>
      </a>

      <nav class="site-nav" aria-label="Main">
        <ul class="nav-links">
          <li class="nav-indicator" aria-hidden="true"></li>
          {
            navLinks.map((link) => (
              <li>
                <a href={link.href} aria-current={link.current ? "page" : undefined}>
                  {link.label}
                </a>
              </li>
            ))
          }
        </ul>
        <a class="nav-cta" href="#contact">Contact</a>
      </nav>
    </header>

    <main>
      <section class="hero">
        <div class="hero-stage">
          <div class="hero-visual" role="img" aria-label="The o.f.f. logo in liquid metal">
            <div class="hero-shader" data-liquid-metal data-mask={offWordmark.src} data-scale="0.8" data-background="#ffffff"></div>
            <!-- Shown only if the shader can't run -->
            <img class="hero-fallback" src={offWordmark.src} alt="" hidden data-liquid-metal-fallback />
          </div>
        </div>

        <div class="hero-intro">
          <h1>Put your phone away.<br />Stay reachable.</h1>
          <div class="hero-aside">
            <p>
              We’re building a personal device that filters incoming messages and alerts, so the things that matter can
              reach you while your phone stays out of reach.
            </p>
            <a class="button-outline" href="#how-it-works">See how it works</a>
          </div>
        </div>
      </section>

      <section class="device" id="how-it-works">
        <figure>
          <Fragment set:html={deviceTeardown} />
          <figcaption>Concept illustration</figcaption>
        </figure>
      </section>
    </main>

    <script>
      // Slides the white tab indicator with a critically damped spring
      // (damping ratio 1, response 0.2s). Re-targeting mid-flight keeps the
      // current position and velocity, so rapid clicks never jump.
      const list = document.querySelector<HTMLUListElement>(".nav-links");
      const indicator = list?.querySelector<HTMLElement>(".nav-indicator");

      if (list && indicator) {
        const links = [...list.querySelectorAll<HTMLAnchorElement>("a")];
        const reduceMotion = window.matchMedia("(prefers-reduced-motion: reduce)");
        const omega = (2 * Math.PI) / 0.2;
        const springs = {
          x: { value: 0, velocity: 0, target: 0 },
          width: { value: 0, velocity: 0, target: 0 },
        };
        let current = links.find((link) => link.hash === window.location.hash) ?? links.find((link) => link.ariaCurrent);
        let frame = 0;
        let lastTime = 0;

        const render = () => {
          indicator.style.transform = `translateX(${springs.x.value}px)`;
          indicator.style.width = `${springs.width.value}px`;
        };

        const tick = (time: number) => {
          // Clamp long gaps (e.g. a background tab) and integrate in small steps for stability
          const dt = Math.min((time - lastTime) / 1000, 1 / 30);
          lastTime = time;
          let settled = true;

          for (const spring of Object.values(springs)) {
            for (let remaining = dt; remaining > 0; remaining -= 1 / 240) {
              const step = Math.min(remaining, 1 / 240);
              const acceleration = -omega * omega * (spring.value - spring.target) - 2 * omega * spring.velocity;
              spring.velocity += acceleration * step;
              spring.value += spring.velocity * step;
            }
            if (Math.abs(spring.value - spring.target) > 0.1 || Math.abs(spring.velocity) > 0.1) {
              settled = false;
            } else {
              spring.value = spring.target;
              spring.velocity = 0;
            }
          }

          render();
          frame = settled ? 0 : requestAnimationFrame(tick);
        };

        const moveTo = (link: HTMLAnchorElement, animate: boolean) => {
          springs.x.target = link.offsetLeft;
          springs.width.target = link.offsetWidth;

          if (!animate || reduceMotion.matches) {
            cancelAnimationFrame(frame);
            frame = 0;
            for (const spring of Object.values(springs)) {
              spring.value = spring.target;
              spring.velocity = 0;
            }
            render();
          } else if (!frame) {
            lastTime = performance.now();
            frame = requestAnimationFrame(tick);
          }
        };

        const select = (link: HTMLAnchorElement, animate: boolean) => {
          links.forEach((other) => other.removeAttribute("aria-current"));
          link.setAttribute("aria-current", "page");
          current = link;
          moveTo(link, animate);
        };

        if (current) select(current, false);
        list.classList.add("is-enhanced");

        links.forEach((link) => link.addEventListener("click", () => select(link, true)));

        // Font loading and breakpoint changes alter tab widths; re-measure without animating
        new ResizeObserver(() => current && moveTo(current, false)).observe(list);
      }
    </script>

    <script>
      import {
        ShaderMount,
        ShaderFitOptions,
        LiquidMetalShapes,
        defaultObjectSizing,
        getShaderColorFromString,
        liquidMetalFragmentShader,
        toProcessedLiquidMetal,
      } from "@paper-design/shaders";

      // Paper's Liquid Metal shader on every [data-liquid-metal] element, masked by its data-mask image.
      // If WebGL or image processing fails, a [data-liquid-metal-fallback] sibling is shown instead.
      const reduceMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

      const mountLiquidMetal = async (container: HTMLElement) => {
        const { mask: maskUrl, scale = "1", background = "#ffffff", pixelRatio = "2" } = container.dataset;
        if (!maskUrl) return;

        try {
          const { pngBlob } = await toProcessedLiquidMetal(maskUrl);
          const mask = new Image();
          mask.src = URL.createObjectURL(pngBlob);
          await mask.decode();

          new ShaderMount(
            container,
            liquidMetalFragmentShader,
            {
              u_image: mask,
              u_isImage: true,
              u_shape: LiquidMetalShapes.none,
              u_colorBack: getShaderColorFromString(background),
              u_colorTint: getShaderColorFromString("#ffffff"),
              u_repetition: 2,
              u_softness: 0.1,
              u_shiftRed: 0.3,
              u_shiftBlue: 0.3,
              u_distortion: 0.07,
              u_contour: 0.4,
              u_angle: 70,
              u_fit: ShaderFitOptions.contain,
              u_scale: Number(scale),
              u_rotation: defaultObjectSizing.rotation,
              u_offsetX: defaultObjectSizing.offsetX,
              u_offsetY: defaultObjectSizing.offsetY,
              u_originX: defaultObjectSizing.originX,
              u_originY: defaultObjectSizing.originY,
              u_worldWidth: defaultObjectSizing.worldWidth,
              u_worldHeight: defaultObjectSizing.worldHeight,
            },
            undefined,
            reduceMotion ? 0 : 1,
            0,
            Number(pixelRatio),
            undefined,
            ["u_image"],
          );

          requestAnimationFrame(() => container.classList.add("is-ready"));
        } catch (error) {
          console.warn("Liquid metal shader unavailable, showing flat logo.", error);
          container.parentElement?.querySelector("[data-liquid-metal-fallback]")?.removeAttribute("hidden");
        }
      };

      document.querySelectorAll<HTMLElement>("[data-liquid-metal]").forEach(mountLiquidMetal);
    </script>

    <script>
      // Explodes the teardown on hover. Each pose needs its own hidden-line pass, so a worker
      // renders the frames once the page is idle; playback steps through them and reverses
      // from wherever it is when the pointer leaves.
      const figure = document.querySelector<HTMLElement>(".device figure");
      const frameGroup = figure?.querySelector<SVGGElement>(".teardown-frame");

      if (figure && frameGroup && window.matchMedia("(hover: hover)").matches) {
        const FRAMES = 24;
        const DURATION = 400;
        const reduceMotion = window.matchMedia("(prefers-reduced-motion: reduce)");
        const frames: SVGGElement[] = [];
        let rendered = 0;
        let progress = 0;
        let target = 0;
        let shown = 0;
        let lastTime = 0;
        let raf = 0;

        const show = (index: number) => {
          if (index === shown) return;
          frameGroup.replaceChildren(frames[index]);
          shown = index;
        };

        const tick = (time: number) => {
          const step = (time - lastTime) / DURATION;
          lastTime = time;
          progress = target > progress ? Math.min(target, progress + step) : Math.max(target, progress - step);
          show(Math.round(progress * (FRAMES - 1)));
          raf = progress === target ? 0 : requestAnimationFrame(tick);
        };

        const play = () => {
          if (rendered < FRAMES) return;
          if (reduceMotion.matches) {
            progress = target;
            show(target * (FRAMES - 1));
          } else if (!raf) {
            lastTime = performance.now();
            raf = requestAnimationFrame(tick);
          }
        };

        const worker = new Worker(new URL("../scripts/teardown-worker.js", import.meta.url), { type: "module" });
        worker.onmessage = ({ data }: MessageEvent<{ index: number; markup: string }>) => {
          const frame = document.createElementNS("http://www.w3.org/2000/svg", "g");
          frame.innerHTML = data.markup;
          frames[data.index] = frame;
          if (++rendered === FRAMES) {
            worker.terminate();
            play(); // catch up if the pointer arrived while frames were rendering
          }
        };
        const start = () => worker.postMessage({ id: "xteink-x4", frames: FRAMES });
        if ("requestIdleCallback" in window) requestIdleCallback(start);
        else setTimeout(start, 1000);

        figure.addEventListener("pointerenter", () => {
          target = 1;
          play();
        });
        figure.addEventListener("pointerleave", () => {
          target = 0;
          play();
        });
      }
    </script>
  </body>
</html>

<style is:global>
  @font-face {
    font-family: "Volksans";
    src: url("/fonts/volksans_Regular.otf") format("opentype");
    font-weight: 400;
    font-display: swap;
  }

  @font-face {
    font-family: "Volksans";
    src: url("/fonts/volksans_SemiBold.otf") format("opentype");
    font-weight: 600;
    font-display: swap;
  }

  @font-face {
    font-family: "Volksans M";
    src: url("/fonts/volksans_SemiBold_M.otf") format("opentype");
    font-weight: 600;
    font-display: swap;
  }

  :root {
    --color-ink: #212121;
    --color-ink-muted: rgb(33 33 33 / 0.5);
    --color-surface: #fff;
    --color-glass: rgb(241 241 241 / 0.8);
    --color-glass-nav: rgb(241 241 241 / 0.76);
    --color-border: rgb(0 0 0 / 0.5);
    --font-sans: "Volksans", system-ui, sans-serif;
    /* Neue Haas Grotesk Display: "neue-haas-grotesk-display" is the Adobe Fonts web name, the second the desktop name */
    --font-display: "neue-haas-grotesk-display", "Neue Haas Grotesk Display Pro", "Helvetica Neue", Helvetica, Arial, sans-serif;
    --font-label: "ABC Areal Mono", "Volksans M", ui-monospace, monospace;
    --font-ui: "ABC Areal", "Volksans", system-ui, sans-serif;
    --gutter: 12px;
    --radius-pill: 9999px;
    /* Critically damped spring (damping 1, response 0.4s) sampled for CSS */
    --ease-spring: linear(0, 0.06, 0.186, 0.329, 0.466, 0.584, 0.682, 0.76, 0.821, 0.868, 0.903, 0.929, 0.949, 0.963, 0.973, 0.981, 0.986, 0.99, 0.993, 0.995, 0.997, 0.998, 0.998, 0.999, 1);
    --spring-duration: 600ms;
    --press-scale: 0.96;
  }

  html {
    -webkit-font-smoothing: antialiased;
  }

  body {
    margin: 0;
    background: var(--color-surface);
    color: var(--color-ink);
    font-family: var(--font-sans);
  }

  a {
    color: inherit;
    text-decoration: none;
  }
</style>

<style>
  /* Header */
  .site-header {
    position: fixed;
    inset: var(--gutter) var(--gutter) auto;
    z-index: 10;
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 8px;
  }

  .brand {
    display: flex;
    align-items: center;
    gap: 16px;
    padding: 10px 16px 10px 10px;
    border: 0.5px solid var(--color-border);
    border-radius: var(--radius-pill);
    background: var(--color-glass);
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
  }

  .brand-mark {
    position: relative;
    display: block;
    width: 31px;
    height: 20px;
    padding: 0 0.3px;
    box-sizing: border-box;
  }

  .brand-mark img {
    display: block;
    width: 100%;
    height: 100%;
    transition: opacity 600ms ease;
  }

  /* Canvas overhangs the mark by 3px so the metal's edges aren't clipped */
  .brand-mark-shader {
    position: absolute;
    inset: -3px;
    opacity: 0;
    transition: opacity 600ms ease;
  }

  .brand-mark-shader.is-ready {
    opacity: 1;
  }

  /* Cross-fade from the flat mark to the shader */
  .brand-mark:has(.brand-mark-shader.is-ready) img {
    opacity: 0;
  }

  .brand-wordmark {
    position: relative;
    display: block;
    width: 120px;
    height: 20px;
  }

  .brand-wordmark img {
    position: absolute;
    display: block;
  }

  .wm-optimizing {
    inset: 15.84% 56.33% -0.01% 0.44%;
    width: 43.23%;
    height: 84.17%;
  }

  .wm-for {
    inset: 4.96% 38.73% 20.51% 47.56%;
    width: 13.71%;
    height: 74.53%;
  }

  .wm-freedom {
    inset: 4.8% -0.02% 6.34% 62.59%;
    width: 37.43%;
    height: 88.86%;
  }

  .site-nav {
    display: flex;
    align-items: center;
    gap: 4px;
  }

  .nav-links {
    position: relative;
    display: flex;
    align-items: center;
    margin: 0;
    padding: 1px;
    list-style: none;
    border-radius: var(--radius-pill);
    background: var(--color-glass-nav);
    backdrop-filter: blur(5px);
    -webkit-backdrop-filter: blur(5px);
  }

  .nav-indicator {
    position: absolute;
    top: 1px;
    bottom: 1px;
    left: 0;
    border-radius: var(--radius-pill);
    background: rgb(255 255 255 / 0.9);
    opacity: 0;
    pointer-events: none;
    will-change: transform, width;
  }

  /* Once the script has positioned the indicator, it replaces the static highlight */
  .nav-links.is-enhanced .nav-indicator {
    opacity: 1;
  }

  .nav-links a {
    position: relative;
    z-index: 1;
    display: block;
    padding: 10px 20px 9px;
    border-radius: var(--radius-pill);
    font-family: var(--font-label);
    font-size: 12px;
    font-weight: 500;
    line-height: 1.5;
    text-transform: uppercase;
    color: var(--color-ink-muted);
    transition: transform var(--spring-duration) var(--ease-spring);
  }

  .nav-links a[aria-current="page"] {
    background: rgb(255 255 255 / 0.9);
    color: var(--color-ink);
  }

  .nav-links.is-enhanced a[aria-current="page"] {
    background: transparent;
  }

  .nav-cta {
    padding: 14px 20px 13px;
    border: 0.5px solid #000;
    border-radius: var(--radius-pill);
    background: #000;
    color: #fff;
    font-family: var(--font-label);
    font-size: 12px;
    font-weight: 500;
    line-height: 1;
    text-transform: uppercase;
    white-space: nowrap;
    transition: transform var(--spring-duration) var(--ease-spring);
  }

  /* Hero: fills the viewport; spacing scales with its height and tops out at the 982px design frame */
  .hero {
    display: flex;
    flex-direction: column;
    box-sizing: border-box;
    min-height: 100vh;
    min-height: 100svh;
    /* The title sits one gutter (12px) above the bottom edge */
    padding: clamp(80px, 25.15svh, 247px) var(--gutter) var(--gutter);
  }

  /* Takes whatever height the spacing and text leave, so the hero always fits the viewport */
  .hero-stage {
    flex: 1 1 0;
    min-height: 180px;
    container-type: size;
  }

  .hero-visual {
    position: relative;
    /* Largest 709:409 box that fits the stage, capped at the design size */
    width: min(709px, 100cqw, 173.35cqh);
    aspect-ratio: 709 / 409;
    margin: 0 auto;
    overflow: hidden;
    background: var(--color-surface);
  }

  /* Same footprint as the shader render (contain fit at scale 0.8) */
  .hero-fallback {
    position: absolute;
    top: 50%;
    left: 50%;
    width: 80%;
    height: auto;
    transform: translate(-50%, -50%);
  }

  .hero-shader {
    position: absolute;
    inset: 0;
    opacity: 0;
    transition: opacity 600ms ease;
  }

  .hero-shader.is-ready {
    opacity: 1;
  }

  .hero-intro {
    display: grid;
    /* Second column starts at 75% of the viewport, as in the design */
    grid-template-columns: calc(75% + var(--gutter) / 2) minmax(0, 365px);
    align-items: start;
    /* Pinned to the bottom of the hero, never closer than the scaled design gap */
    margin-top: auto;
    padding-top: clamp(24px, 9.06svh, 89px);
  }

  h1 {
    margin: 0;
    font-family: var(--font-display);
    font-size: clamp(44px, 6.35vw, 96px);
    font-weight: 500;
    line-height: 1;
    letter-spacing: -0.025em;
  }

  .hero-aside {
    padding-top: 24px;
  }

  .hero-aside p {
    margin: 0;
    font-family: var(--font-ui);
    font-size: 16px;
    font-weight: 500;
    line-height: 1.2;
    letter-spacing: -0.02em;
  }

  .button-outline {
    display: inline-flex;
    margin-top: 35px;
    padding: 10px 24px;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-pill);
    background: var(--color-surface);
    font-family: var(--font-ui);
    font-size: 12px;
    font-weight: 500;
    line-height: 1.5;
    letter-spacing: -0.02em;
    transition: transform var(--spring-duration) var(--ease-spring);
  }

  /* Hover states switch instantly; only where a real pointer can hover, so taps don't leave a stuck state */
  @media (hover: hover) {
    .nav-links a:hover {
      color: var(--color-ink);
    }

    .nav-cta:hover {
      background: #2a2a2a;
    }

    .button-outline:hover {
      background: #f5f5f5;
    }
  }

  /* Press feedback lands instantly on pointer-down; release springs back */
  .nav-links a:active,
  .nav-cta:active,
  .button-outline:active {
    transform: scale(var(--press-scale));
    transition-duration: 100ms;
    transition-timing-function: ease-out;
  }

  @media (prefers-reduced-motion: reduce) {
    .nav-links a:active,
    .nav-cta:active,
    .button-outline:active {
      transform: none;
    }
  }

  /* Device teardown */
  .device {
    padding: 64px var(--gutter) 120px;
    scroll-margin-top: 64px;
  }

  .device figure {
    margin: 0 auto;
    /* Small enough that part labels would be unreadable, so the unlabelled render is used */
    max-width: 374px;
  }

  .device :global(.device-teardown) {
    display: block;
    width: 100%;
    height: auto;
    color: var(--color-ink);
  }

  /* Hold line weights in screen pixels so they stay visible at this small size */
  .device :global(.device-teardown path) {
    vector-effect: non-scaling-stroke;
  }

  .device :global(.device-teardown [data-line-role="outline"]) {
    stroke-width: 1px;
  }

  .device :global(.device-teardown [data-line-role="edge"]) {
    stroke-width: 0.75px;
  }

  .device :global(.device-teardown [data-line-role="detail"]) {
    stroke-width: 0.5px;
  }

  .device figcaption {
    margin-top: 16px;
    font-family: var(--font-label);
    font-size: 12px;
    font-weight: 600;
    line-height: 1.5;
    text-align: center;
    text-transform: uppercase;
    color: var(--color-ink-muted);
  }

  :focus-visible {
    outline: 2px solid var(--color-ink);
    outline-offset: 2px;
  }

  @media (max-width: 900px) {
    .hero {
      padding-top: clamp(88px, 14svh, 120px);
    }

    .hero-intro {
      grid-template-columns: 1fr;
      gap: 24px;
      padding-top: clamp(24px, 6svh, 48px);
    }

    .hero-aside {
      padding-top: 0;
      max-width: 365px;
    }

    .button-outline {
      margin-top: 24px;
    }
  }

  @media (max-width: 720px) {
    .nav-links {
      display: none;
    }
  }
</style>
