---
// Preview of the homepage intro animation: the homepage in a full-window frame with ?intro, plus
// controls to replay it and slow it down. Speed changes apply live to the running Motion timeline;
// the chosen speed is kept in this page's URL (?speed=0.1) and used for each replay.
const speeds = [1, 0.5, 0.1];
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/png" href="/favicon.png" />
    <title>o.f.f. intro</title>
  </head>
  <body>
    <iframe class="stage" title="Homepage with intro animation"></iframe>

    <div class="controls" role="group" aria-label="Intro playback">
      <button class="restart" type="button">Restart</button>
      <div class="speeds" role="radiogroup" aria-label="Speed">
        {
          speeds.map((speed) => (
            <button type="button" role="radio" aria-checked={speed === 1 ? "true" : "false"} data-speed={speed}>
              {speed}×
            </button>
          ))
        }
      </div>
    </div>

    <script>
      const stage = document.querySelector<HTMLIFrameElement>(".stage")!;
      const speedButtons = [...document.querySelectorAll<HTMLButtonElement>("[data-speed]")];
      let speed = Number(new URLSearchParams(location.search).get("speed")) || 1;
      if (!speedButtons.some((button) => Number(button.dataset.speed) === speed)) speed = 1;

      // A fresh load of the homepage replays the intro from the start
      const play = () => {
        stage.src = `/?intro${speed === 1 ? "" : `&speed=${speed}`}&t=${Date.now()}`;
      };

      const setSpeed = (next: number) => {
        speed = next;
        speedButtons.forEach((button) => button.setAttribute("aria-checked", String(Number(button.dataset.speed) === speed)));
        const url = new URL(location.href);
        if (speed === 1) url.searchParams.delete("speed");
        else url.searchParams.set("speed", String(speed));
        history.replaceState(null, "", url);
        // Same origin, so the running intro picks this up mid-animation
        stage.contentWindow?.postMessage({ type: "intro-speed", speed }, location.origin);
      };

      document.querySelector(".restart")!.addEventListener("click", play);
      speedButtons.forEach((button) => button.addEventListener("click", () => setSpeed(Number(button.dataset.speed))));
      setSpeed(speed);
      play();
    </script>
  </body>
</html>

<style>
  html,
  body {
    margin: 0;
    height: 100%;
    background: #000;
  }

  .stage {
    display: block;
    width: 100%;
    height: 100%;
    border: 0;
  }

  .controls {
    position: fixed;
    right: 12px;
    bottom: 12px;
    display: flex;
    gap: 4px;
    padding: 4px;
    border-radius: 9999px;
    background: rgb(20 20 20 / 0.88);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    box-shadow: 0 8px 24px rgb(0 0 0 / 0.25);
    font: 500 12px/1 ui-monospace, SFMono-Regular, Menlo, monospace;
  }

  .speeds {
    display: flex;
    gap: 2px;
  }

  button {
    padding: 9px 14px;
    border: 0;
    border-radius: 9999px;
    background: transparent;
    color: rgb(255 255 255 / 0.6);
    font: inherit;
    text-transform: uppercase;
    cursor: pointer;
  }

  .restart {
    background: #fff;
    color: #000;
  }

  .speeds button[aria-checked="true"] {
    background: rgb(255 255 255 / 0.16);
    color: #fff;
  }

  @media (hover: hover) {
    .speeds button:hover {
      color: #fff;
    }

    .restart:hover {
      background: #e6e6e6;
    }
  }

  .restart:active {
    transform: scale(0.96);
  }

  button:focus-visible {
    outline: 2px solid #fff;
    outline-offset: 2px;
  }
</style>
