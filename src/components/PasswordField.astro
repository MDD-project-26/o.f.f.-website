---
// The demo's password field: label, input with a show/hide toggle, and an Enter button that shrinks into a
// spinner for a second. The form never submits (so the password stays out of the URL); after the spinner it
// fires a "password-submit" event on the form, with the password in event.detail, and resets the button.
// Needs src/styles/demo-base.css (fonts, tokens and .button-pill) on the page.
---

<form class="gate-form">
  <label class="gate-label" for="demo-password">Password</label>
  <div class="gate-field">
    <input
      class="gate-input"
      id="demo-password"
      name="password"
      type="password"
      placeholder="Enter password"
      autocomplete="current-password"
      required
    />
    <button class="gate-reveal" type="button" aria-label="Show password" aria-controls="demo-password" data-shown="false">
      <span class="reveal-show" aria-hidden="true">Show</span>
      <span class="reveal-hide" aria-hidden="true">Hide</span>
    </button>
    <button class="button-pill gate-submit" type="submit">
      <span class="gate-submit-label">Enter <span aria-hidden="true">→</span></span>
      <span class="gate-spinner" aria-hidden="true"></span>
    </button>
  </div>
</form>

<script>
  for (const form of document.querySelectorAll<HTMLFormElement>(".gate-form")) {
    const input = form.querySelector<HTMLInputElement>(".gate-input");
    const reveal = form.querySelector<HTMLButtonElement>(".gate-reveal");
    const submit = form.querySelector<HTMLButtonElement>(".gate-submit");

    // Show/hide toggle. Focus goes back to the input so typing carries on.
    reveal?.addEventListener("click", () => {
      if (!input) return;
      const show = input.type === "password";
      input.type = show ? "text" : "password";
      reveal.dataset.shown = String(show);
      reveal.setAttribute("aria-label", show ? "Hide password" : "Show password");
      input.focus();
    });

    form.addEventListener("submit", (event) => {
      event.preventDefault();
      if (!submit || submit.getAttribute("aria-busy") === "true") return;
      // Pin the current width so the transition has a start value, then shrink to a circle around the spinner
      submit.style.width = `${submit.offsetWidth}px`;
      void submit.offsetWidth;
      submit.setAttribute("aria-busy", "true");
      submit.style.width = `${submit.offsetHeight}px`;
      window.setTimeout(() => {
        submit.removeAttribute("aria-busy");
        submit.style.width = "";
        form.dispatchEvent(new CustomEvent("password-submit", { detail: input?.value ?? "" }));
      }, 1000);
    });
  }
</script>

<style>
  .gate-form {
    display: flex;
    flex-direction: column;
    width: min(488px, 100%);
    text-align: left;
  }

  .gate-label {
    padding: 0 0 8px 20px;
    font-family: var(--font-label);
    font-size: 10px;
    font-weight: 400;
    line-height: 1;
    text-transform: uppercase;
  }

  .gate-field {
    display: flex;
    align-items: center;
    gap: 8px;
    padding: 2.5px 2.5px 2.5px 21px;
    border: 1px solid rgb(255 255 255 / 0.04);
    border-radius: var(--radius-pill);
    background: var(--color-glass-dark);
    transition: border-color 0.2s ease;
  }

  .gate-field:focus-within {
    border-color: rgb(255 255 255 / 0.24);
  }

  .gate-input {
    flex: 1;
    min-width: 0;
    padding: 0;
    border: 0;
    outline: none;
    background: none;
    color: var(--color-on-dark);
    font-family: var(--font-ui);
    font-size: 13px;
    line-height: 1;
  }

  /* iOS Safari zooms the page into any focused field under 16px */
  @media (pointer: coarse) {
    .gate-input {
      font-size: 16px;
    }
  }

  /* Enter button: while busy, the label fades out (keeping the button's width) and a spinner turns in its place */
  .gate-submit {
    position: relative;
    box-sizing: border-box;
    overflow: hidden;
    transition:
      transform 160ms cubic-bezier(0.23, 1, 0.32, 1),
      width 300ms cubic-bezier(0.23, 1, 0.32, 1);
  }

  /* The hover rules change transition-duration; keep the width's own timing while busy */
  .gate-submit[aria-busy="true"] {
    transition-duration: 160ms, 300ms;
  }

  .gate-submit-label {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    transition: opacity 150ms ease;
  }

  .gate-spinner {
    position: absolute;
    inset: 0;
    width: 14px;
    height: 14px;
    margin: auto;
    box-sizing: border-box;
    border: 1.5px solid rgb(33 33 34 / 0.2);
    border-top-color: #212122;
    border-radius: 50%;
    opacity: 0;
    transition: opacity 150ms ease;
    animation: gate-spin 700ms linear infinite;
  }

  .gate-submit[aria-busy="true"] {
    cursor: progress;
  }

  .gate-submit[aria-busy="true"] .gate-submit-label {
    opacity: 0;
  }

  .gate-submit[aria-busy="true"] .gate-spinner {
    opacity: 1;
  }

  @keyframes gate-spin {
    to {
      transform: rotate(1turn);
    }
  }

  /* Slower turn for reduced motion, so there's still a sign that something is happening */
  @media (prefers-reduced-motion: reduce) {
    .gate-spinner {
      animation-duration: 1.6s;
    }

    .gate-submit,
    .gate-submit[aria-busy="true"] {
      transition: none;
    }
  }

  /* Edge's built-in reveal button would double up with ours */
  .gate-input::-ms-reveal {
    display: none;
  }

  /* Show/hide password toggle, sitting between the input and Enter */
  .gate-reveal {
    display: grid;
    place-items: center;
    flex: none;
    height: 36px;
    padding: 0 10px;
    border: 0;
    border-radius: var(--radius-pill);
    background: none;
    color: var(--color-on-dark-muted);
    font-family: var(--font-label);
    font-size: 10px;
    font-weight: 400;
    line-height: 1;
    text-transform: uppercase;
    cursor: pointer;
  }

  .gate-reveal:focus-visible {
    outline: 2px solid var(--color-on-dark);
    outline-offset: 0;
  }

  @media (hover: hover) {
    .gate-reveal:hover {
      color: var(--color-on-dark);
    }
  }

  /* Both words share one cell (the button fits the wider) and cross-fade: the outgoing one shrinks and blurs out
     as the other comes in */
  .gate-reveal span {
    grid-area: 1 / 1;
    transition:
      opacity 200ms cubic-bezier(0.23, 1, 0.32, 1),
      transform 200ms cubic-bezier(0.23, 1, 0.32, 1),
      filter 200ms cubic-bezier(0.23, 1, 0.32, 1);
  }

  .gate-reveal[data-shown="true"] .reveal-show,
  .gate-reveal[data-shown="false"] .reveal-hide {
    opacity: 0;
    transform: scale(0.7);
    filter: blur(4px);
  }

  /* Press feedback, as on the other buttons */
  .gate-reveal {
    transition:
      color 0.2s ease,
      transform 160ms cubic-bezier(0.23, 1, 0.32, 1);
  }

  .gate-reveal:active {
    transform: scale(0.9);
  }

  @media (prefers-reduced-motion: reduce) {
    .gate-reveal:active {
      transform: none;
    }

    .gate-reveal span {
      transition: opacity 150ms ease;
    }

    .gate-reveal[data-shown="true"] .reveal-show,
    .gate-reveal[data-shown="false"] .reveal-hide {
      transform: none;
      filter: none;
    }
  }

  .gate-input::placeholder {
    color: var(--color-on-dark-muted);
    opacity: 1;
  }
</style>
