---
// Page-load intro: the white o.f.f. mark on black switches on, then grows into the hero's liquid
// metal logo while the black fades away. The hero logo is the mark's "Off" letters without the pill,
// so during the grow both are scaled together with their letters overlapping exactly. Mark paths and
// knob/mask geometry match src/pages/toggle.astro. Animated with Motion (motion.dev).
---

<!-- Plays when the page opens at the top: skipped on a reload or back/forward visit that the browser will put
     back below the top (it restores the scroll only after this runs, so the position saved on leaving is used),
     on links to a section (#problem), and when arriving from another page of the site (the demo, the blog).
     ?speed=0.5 slows it down; ?nointro skips it. Runs before first paint,
     so the page never flashes before the overlay. -->
<script is:inline>
  (() => {
    const KEY = "intro-scroll-y";
    let savedY = 0;
    try {
      savedY = Number(sessionStorage.getItem(KEY)) || 0;
    } catch {}
    addEventListener("pagehide", () => {
      try {
        sessionStorage.setItem(KEY, String(scrollY));
      } catch {}
    });

    const navigation = performance.getEntriesByType("navigation")[0];
    const restoresScroll = navigation?.type === "reload" || navigation?.type === "back_forward";
    const opensAtTop = !location.hash && !(restoresScroll && savedY > 0);
    // Same-origin links send their full URL as the referrer, so this catches every other page of the site
    let fromSitePage = false;
    try {
      const from = new URL(document.referrer);
      fromSitePage = from.origin === location.origin && from.pathname !== location.pathname;
    } catch {}
    if (opensAtTop && !fromSitePage && !new URLSearchParams(location.search).has("nointro")) {
      document.documentElement.classList.add("has-intro");
      lockScroll();
    }

    // Holds the page at the top while the intro plays, without hiding the scrollbar (overflow: hidden would, and
    // the page would shift sideways when it came back). Lets go when the intro removes has-intro.
    function lockScroll() {
      const root = document.documentElement;
      const SCROLL_KEYS = new Set([" ", "PageUp", "PageDown", "Home", "End", "ArrowUp", "ArrowDown"]);
      const block = (event) => event.preventDefault();
      const blockKeys = (event) => SCROLL_KEYS.has(event.key) && event.preventDefault();
      // Dragging the scrollbar can't be prevented, so that is undone instead
      const holdTop = () => scrollY !== 0 && scrollTo(0, 0);
      addEventListener("wheel", block, { passive: false });
      addEventListener("touchmove", block, { passive: false });
      addEventListener("keydown", blockKeys);
      addEventListener("scroll", holdTop);
      const observer = new MutationObserver(() => {
        if (root.classList.contains("has-intro")) return;
        observer.disconnect();
        removeEventListener("wheel", block);
        removeEventListener("touchmove", block);
        removeEventListener("keydown", blockKeys);
        removeEventListener("scroll", holdTop);
      });
      observer.observe(root, { attributes: true, attributeFilter: ["class"] });
    }
  })();
  // The title starts with its first line in the second's place, with or without the intro
  document.documentElement.classList.add("title-push");
</script>

<div class="intro" aria-hidden="true">
  <!-- The pill and the letters are separate layers: the letters land on the hero logo, the pill keeps going -->
  <div class="intro-mark">
    <svg class="intro-ring" viewBox="0 0 31 20" fill="none" xmlns="http://www.w3.org/2000/svg">
      <!-- The page is seen through the pill: solid ground colour outside its outer edge, which scales away with
           the ring, and a fill inside it that fades. Before the grow both just sit on the overlay's ground. -->
      <defs>
        <!-- Soft shadow under the ring, in its own units so it grows with it. It only shows where it falls inward
             onto the page; outside it lands on the solid ground. -->
        <filter id="intro-ring-shadow" x="-20%" y="-30%" width="140%" height="160%">
          <feDropShadow dx="0" dy="0.3" stdDeviation="0.6" flood-color="#000" flood-opacity="0.3"></feDropShadow>
        </filter>
      </defs>
      <path class="intro-outside" d="M-5000 -5000H5000V5000H-5000ZM20.3848 0C25.9075 8.09981e-05 30.3848 4.4772 30.3848 10C30.3848 15.4797 25.977 19.9298 20.5137 19.999L20.3848 20H10L9.87109 19.999C4.40779 19.9298 0 15.4797 0 10C9.66387e-08 4.47715 4.47715 2.01953e-07 10 0H20.3848Z" fill-rule="evenodd"></path>
