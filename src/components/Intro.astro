        <g class="intro-knob">
          <circle class="intro-knob-core" cx="10.0004" cy="10.0002" r="4.2"></circle>
          <path class="intro-shape" d="M10.0004 4.6154C12.9741 4.61548 15.3851 7.02638 15.3851 10.0002C15.3851 12.9739 12.9741 15.3849 10.0004 15.3849C7.02658 15.3849 4.61568 12.9739 4.6156 10.0002C4.6156 7.02633 7.02653 4.6154 10.0004 4.6154ZM10.0004 6.15349C7.87619 6.15349 6.15369 7.876 6.15369 10.0002C6.15377 12.1243 7.87624 13.8459 10.0004 13.8459C12.1244 13.8458 13.846 12.1242 13.8461 10.0002C13.8461 7.87605 12.1245 6.15357 10.0004 6.15349Z"></path>
        </g>
      </g>
    </svg>
  </div>
</div>

<script>
  import { animate, motionValue, stagger } from "motion";

  // The whole intro is one Motion timeline, overlapped so it reads as one motion:
  // 1. the pill scales in from 0 on the grow's curve; the knob and letters inside stay at full size, uncovered by
  //    its opening as it grows;
  // 2. after a short hold on the landed mark, the knob switches from off (right, letters hidden) to on (the
  //    full logo) on a cubic ease-in-out, the ff sliding into place with it;
  // 3. a beat after the knob lands, the grow (an asymmetric ease-in-out): the mark and the hero's liquid
  //    metal logo grow together with their letters overlapping 1:1, the white letters fade, the page shows
  //    through the pill (solid black outside it, a fading fill inside) as it zooms out past the viewport, and
  //    the header and hero text slide in, the title showing only its first line, in the second line's place;
  // 4. 0.35s after the title lands, the second line's words rise one by one out of a clip below it,
  //    pushing the first line up into place.
  //    Without the intro, the title push still plays, 0.2s after the page loads.
  // ?speed= (e.g. 0.1) sets the playback rate; the /intro preview page can also change it live.
  const intro = document.querySelector<HTMLElement>(".intro");
  const SPEED = Number(new URLSearchParams(location.search).get("speed")) || 1;

  // The scale-in, the grow and the title reveal share one curve: an asymmetric ease-in-out, slow to pick up and
  // with a long settle. A spring from rest can't start this gently: its first push is set by stiffness alone,
  // and more damping only drags out the end.
  const introEase: [number, number, number, number] = [0.55, 0, 0.15, 1];

  // Title push: the first line and the second line's words ride the same curve, the words staggered, so the
  // reveal reads as pushing the first line. As long on screen as the scale-in.
  const firstLine = document.querySelector<HTMLElement>(".hero-title-line:not(.hero-title-reveal)");
  const words = [...document.querySelectorAll<HTMLElement>(".hero-title-word")];
  // Real seconds before the push: from page load without the intro, or from when the hero text looks landed
  const TITLE_PUSH_DELAY = 0.2;
  const TITLE_PUSH_DELAY_AFTER_INTRO = 0.35;
  const WORD_STAGGER = 0.08;
  // A word sits this far down to clear its line's clip, which reaches 0.2em below the line (see index.astro)
  const WORD_HIDDEN = "120%";
  const PUSH_DURATION = 0.7; // real seconds (not stretched by TEMPO)
  const pushTween = { duration: PUSH_DURATION, ease: introEase };
  let titlePush: ReturnType<typeof animate> | undefined;

  const pushTitle = (delay: number) => {
    const done = () => {
      [firstLine, ...words].forEach((element) => element?.style.removeProperty("transform"));
      document.documentElement.classList.remove("title-push");
    };
    if (!firstLine || !words.length) return done();
    // The first line starts down by the second line's height, so its bottom sits on the second's. Not its own
    // height: on narrow screens the first line wraps and would land on the copy below. Layout offsets ignore the
    // transforms; the second line's bottom padding only makes room for its clip.
    const reveal = firstLine.nextElementSibling as HTMLElement | null;
    const pushFrom = reveal
      ? reveal.offsetTop + reveal.offsetHeight - parseFloat(getComputedStyle(reveal).paddingBottom) - (firstLine.offsetTop + firstLine.offsetHeight)
      : firstLine.offsetHeight;
    titlePush = animate(
      [
        [firstLine, { y: [pushFrom, 0] }, { ...pushTween, at: delay }],
        [words, { y: [WORD_HIDDEN, "0%"] }, { ...pushTween, at: delay, delay: stagger(WORD_STAGGER) }],
      ],
      { reduceMotion: false },
    );
    titlePush.speed = SPEED;
    titlePush.then(done);
  };

  addEventListener("message", ({ data, origin }) => {
    if (origin === location.origin && data?.type === "intro-speed" && typeof data.speed === "number" && titlePush) titlePush.speed = data.speed;
  });

  if (intro && document.documentElement.classList.contains("has-intro")) {
    const svg = intro.querySelector<SVGSVGElement>(".intro-logo")!;
    const ring = intro.querySelector<SVGSVGElement>(".intro-ring")!;
    const inside = intro.querySelector<SVGPathElement>(".intro-inside")!;
    const knob = intro.querySelector<SVGGElement>(".intro-knob")!;
    const opening = intro.querySelector<SVGPathElement>(".intro-opening")!;
    const letters = intro.querySelector<SVGGElement>(".intro-letters")!;
    const maskPassed = intro.querySelector<SVGRectElement>(".intro-mask-passed")!;
    const heroShader = document.querySelector<HTMLElement>(".hero-shader");
    const header = document.querySelector<HTMLElement>(".site-header");
    // The header's contents slide in, not the header: it stays at the top of the screen, above the overlay, for the
    // whole intro, because iOS Safari colours the band behind its status bar from a fixed bar it finds there. With
    // the header gone, Safari showed the black overlay under the status bar instead, and turned white late.
    const headerParts = header ? ([...header.children] as HTMLElement[]) : [];
    const heroText = document.querySelector<HTMLElement>(".hero-intro");

    // Overall pace: every duration below is stretched by this (1.4 = 40% slower), keeping their proportions
    const TEMPO = 1.4;

    // Timing, in seconds at TEMPO 1
    const SCALE_IN = 0.5;
    const SWITCH_AT = 0.75; // the scale-in looks settled by ~0.4, so this leaves a hold before the knob moves
    const SWITCH_DURATION = 0.26; // knob travel from off to on
    const GROW_AFTER_SWITCH = 0.35; // the grow starts this long after the knob lands: the same hold as before the switch
    const SLIDE_STAGGER = { header: 0.07, text: 0.1 }; // header and hero text start this long into the grow

    const GROW_DURATION = 0.9;
    // Header and text slides: critically damped spring with a 0.8s response (stiffness ω², damping 2ω, mass 1).
    // They move in pixels, so they end within half a pixel and the page is usable straight away.
    const SLIDE_OMEGA = (2 * Math.PI) / 0.8;
    // The slide looks landed (a few pixels left) this long after it starts, well before the spring rests
    const TEXT_LANDED_AFTER = 0.8;
    const slideSpring = {
      type: "spring",
      stiffness: SLIDE_OMEGA ** 2,
      damping: 2 * SLIDE_OMEGA,
      restDelta: 0.5,
      restSpeed: 2,
    } as const;

    // Curves Motion's named easings don't cover exactly
    const cubicInOut = (t: number) => (t < 0.5 ? 4 * t ** 3 : 1 - (-2 * t + 2) ** 3 / 2);
    const smoothstep = (t: number) => t * t * (3 - 2 * t);
    const clamp01 = (n: number) => Math.min(Math.max(n, 0), 1);

    // Mark geometry (31x20 viewBox), matching src/pages/toggle.astro
    const KNOB_TRAVEL = 10.3844;
    const LETTERS_SHIFT = 2;
    const KNOB_RADIUS = 5.3847;
    const MASK_MARGIN = 0.5;
    const MASK_INSET = 0.3;
    // The "Off" letters when on: x 4.6156 to 24.231, y 4.6154 to 15.3849
    const LETTERS_CENTRE = { x: 14.4233 / 31, y: 10.0002 / 20 };
    const LETTERS_HEIGHT = 10.7695 / 20;
    // A disc this radius around the letters' centre stays inside the pill's opening
    const RING_INNER_RADIUS = 8.4619;
    // Hero wordmark: viewBox height 324 around a 300-tall glyph, drawn at contain fit, scale 0.8
    const HERO_ASPECT = 571 / 324;
    const HERO_GLYPH_SHARE = (300 / 324) * 0.8;

    // Switch: the knob's offset drives the ff's slide and the letters mask, so they move as one
    const knobX = motionValue(KNOB_TRAVEL);
    const renderSwitch = () => {
      const x = knobX.get();
      const progress = clamp01(x / KNOB_TRAVEL);
      knob.setAttribute("transform", `translate(${x} 0)`);
      letters.setAttribute("transform", `translate(${-LETTERS_SHIFT * progress} 0)`);
      const bandRadius = KNOB_RADIUS - MASK_INSET + (MASK_MARGIN + MASK_INSET) * clamp01(progress * 4);
      maskPassed.setAttribute("y", String(10.0002 - bandRadius));
      maskPassed.setAttribute("height", String(2 * bandRadius));
      maskPassed.setAttribute("width", String(15.0004 + x));
    };
    knobX.on("change", renderSwitch);
    renderSwitch();

    // Scale-in: only the ring grows; the clip on the knob and letters follows its opening
    const scaleIn = motionValue(0);
    scaleIn.on("change", (scale) => {
      ring.style.transform = `scale(${scale})`;
      opening.setAttribute(
        "transform",
        `translate(${LETTERS_CENTRE.x * 31} ${LETTERS_CENTRE.y * 20}) scale(${scale}) translate(${-LETTERS_CENTRE.x * 31} ${-LETTERS_CENTRE.y * 20})`,
      );
    });

    // Grow: one progress value drives everything that has to stay locked together. The mark goes from its
    // own size to the hero letters' size; the hero logo starts shrunk onto the mark's letters and returns to
    // its own size, so their letters overlap 1:1 every frame. Measured when the grow starts.
    type Grow = { dx: number; dy: number; scale: number; ringScale: number };
    let grow: Grow | null | undefined;
    const measureGrow = (): Grow | null => {
      const hero = document.querySelector(".hero-visual")?.getBoundingClientRect();
      const box = svg.getBoundingClientRect();
      if (!heroShader || !hero?.width || !box.height) return null;
      const from = { x: box.left + box.width * LETTERS_CENTRE.x, y: box.top + box.height * LETTERS_CENTRE.y };
      const to = { x: hero.left + hero.width / 2, y: hero.top + hero.height / 2 };
      // Scale at which the pill's opening contains the whole viewport, from either end of the move. The height is
      // the overlay's first screen (100lvh), which on iOS reaches under the toolbar, past innerHeight.
      const screenHeight = Math.max(innerHeight, intro.getBoundingClientRect().height / 2);
      const farthestCorner = Math.max(
        ...[from, to].map(({ x, y }) => Math.hypot(Math.max(x, innerWidth - x), Math.max(y, screenHeight - y))),
      );
      return {
        dx: to.x - from.x,
        dy: to.y - from.y,
        scale: (Math.min(hero.height, hero.width / HERO_ASPECT) * HERO_GLYPH_SHARE) / (box.height * LETTERS_HEIGHT),
        ringScale: (1.05 * farthestCorner) / ((RING_INNER_RADIUS / 20) * box.height),
      };
    };

    // Once the grow ends the ring's opening covers the viewport and the black is gone, so the overlay goes and
    // the page unlocks then, without waiting for the header and text springs to settle their last pixels
    let unlocked = false;
    const unlock = () => {
      if (unlocked) return;
      unlocked = true;
      heroShader?.style.removeProperty("transform");
      intro.remove();
      document.documentElement.classList.remove("has-intro");
    };

    const growP = motionValue(0);
    growP.on("change", (p) => {
      if (grow === undefined) {
        grow = measureGrow();
        // The knob's solid centre only covers seams while it moves; fading it would show a disc
        intro.querySelector(".intro-knob-core")?.remove();
        // From here the ring layer provides the ground: solid outside the pill, a fading fill inside
        intro.style.backgroundColor = "transparent";
      }
      if (grow) {
        const markScale = 1 + (grow.scale - 1) * p;
        const translate = `translate(${grow.dx * p}px, ${grow.dy * p}px)`;
        svg.style.transform = `${translate} scale(${markScale})`;
        // The letters' scale times an exponential extra zoom out to the covering size: one smooth curve, so the
        // ring never changes speed partway, and it never falls behind the letters
        const ringExtra = Math.max(grow.ringScale / grow.scale, 1) ** clamp01(p);
        ring.style.transform = `${translate} scale(${markScale * ringExtra})`;
        heroShader!.style.transform = `translate(${-grow.dx * (1 - p)}px, ${-grow.dy * (1 - p)}px) scale(${markScale / grow.scale})`;
      }
      const dark = String(1 - smoothstep(clamp01(p)));
      inside.style.opacity = dark;
      svg.style.opacity = dark;
      if (p >= 1) unlock();
    });

    const switched = SWITCH_AT + SWITCH_DURATION;
    const growAt = switched + GROW_AFTER_SWITCH;
    const slideFrom = {
      header: header ? -header.getBoundingClientRect().bottom - 12 : 0,
      text: heroText ? Math.max(innerHeight - heroText.getBoundingClientRect().top, 0) + 24 : 0,
    };

    let timeline: ReturnType<typeof animate> | undefined;
    const start = () => {
      const introTimeline = animate(
        [
          [scaleIn, [0, 1], { duration: SCALE_IN, ease: introEase, at: 0 }],
          [knobX, [KNOB_TRAVEL, 0], { duration: SWITCH_DURATION, ease: cubicInOut, at: SWITCH_AT }],
          [growP, [0, 1], { duration: GROW_DURATION, ease: introEase, at: growAt }],
          ...(headerParts.length ? [[headerParts, { y: [slideFrom.header, 0] }, { ...slideSpring, at: growAt + SLIDE_STAGGER.header }] as const] : []),
          ...(heroText ? [[heroText, { y: [slideFrom.text, 0] }, { ...slideSpring, at: growAt + SLIDE_STAGGER.text }] as const] : []),
        ],
        { reduceMotion: false },
      );
      introTimeline.speed = SPEED / TEMPO;
      timeline = introTimeline;

      introTimeline.then(() => {
        unlock();
        headerParts.forEach((part) => part.style.removeProperty("transform"));
        heroText?.style.removeProperty("transform");
      });

      // Scheduled from the start, since the timeline only ends once the text spring rests. Intro seconds run
      // TEMPO times slower than the push's, so they're converted to the push's clock.
      const textLanded = (growAt + SLIDE_STAGGER.text + TEXT_LANDED_AFTER) * TEMPO;
      pushTitle(textLanded + TITLE_PUSH_DELAY_AFTER_INTRO);
    };

    // The /intro preview page changes the speed live
    addEventListener("message", ({ data, origin }) => {
      if (origin === location.origin && data?.type === "intro-speed" && typeof data.speed === "number" && timeline) timeline.speed = data.speed / TEMPO;
    });

    // The hero shader's setup (image processing, shader compile) blocks the main thread for a while, longest in
    // Safari. The timeline runs on the clock, so if that lands during the scale-in, its frames are dropped and the
    // mark just appears. So the black holds until the shader is set up (or SHADER_WAIT at most), then two frames
    // more for its first draw, before anything moves.
    const SHADER_WAIT = 2000; // ms
    new Promise<void>((resolve) => {
      if (!heroShader || "ready" in heroShader.dataset) return resolve();
      heroShader.addEventListener("liquid-metal-ready", () => resolve(), { once: true });
      setTimeout(resolve, SHADER_WAIT);
    }).then(() => requestAnimationFrame(() => requestAnimationFrame(start)));
  } else {
    pushTitle(TITLE_PUSH_DELAY);
  }
</script>

<style>
  .intro {
    /* White mark on a black ground */
    --intro-ground: #000;
    --intro-ink: #fff;
    display: none;
  }

  /* Absolute, not fixed: Safari 26 tints its toolbar from fixed elements at the top of the viewport, so a fixed
     black overlay turned the toolbar black, and Safari only noticed it was gone a few seconds after the intro.
     The page is held at the top while this shows, so it covers the viewport just the same. Clipped, so the
     growing ring doesn't make the page scrollable. */
  :global(html.has-intro) .intro {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    /* Two screens tall, with the mark centred in the first: iOS Safari draws the page on under its floating
       toolbar, past even 100lvh, and a one-screen overlay let the hero title show below it */
    height: 200vh;
    height: 200lvh;
    overflow: clip;
    z-index: 100;
    display: grid;
    grid-template-rows: 100vh;
    grid-template-rows: 100lvh;
    align-content: start;
    place-items: center;
    background: var(--intro-ground);
  }

  /* Until the title push, the first line sits in the second's place and the second's words wait below its clip.
